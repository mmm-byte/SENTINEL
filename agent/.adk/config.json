{
  "mcpServers": {
    "mongodb": {
      "command": "npx",
      "args": ["-y", "@mongodb-js/mongodb-mcp-server"]
    },
    "phoenix": {
      "command": "npx",
      "args": [
        "-y",
        "@arizeai/phoenix-mcp",
        "--baseUrl", "https://app.phoenix.arize.com"
      ],
      "env": {
        "PHOENIX_API_KEY": "${ARIZE_PHOENIX_API_KEY}"
      }
    },
    "fivetran": {
      "command": "npx",
      "args": ["-y", "fivetran-mcp"],
      "env": {
        "FIVETRAN_API_KEY": "${FIVETRAN_API_KEY}",
        "FIVETRAN_API_SECRET": "${FIVETRAN_API_SECRET}"
      }
    },
    "gitlab": {
      "command": "npx",
      "args": ["-y", "@gitlab-org/gitlab-mcp-server"],
      "env": {
        "GITLAB_TOKEN": "${GITLAB_TOKEN}",
        "GITLAB_API_URL": "${GITLAB_API_URL}"
      }
    },
    "elastic": {
      "_comment": "Elastic Agent Builder MCP server — copy endpoint URL from Kibana > Agent Builder > Tools UI",
      "command": "npx",
      "args": [
        "-y",
        "@elastic/mcp-server-elasticsearch"
      ],
      "env": {
        "ES_URL": "${ELASTIC_ENDPOINT}",
        "ES_API_KEY": "${ELASTIC_API_KEY}"
      }
    }
  }
}
