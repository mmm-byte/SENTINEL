# ─────────────────────────────────────────────────────────────────────────────
# SENTINEL — Environment Configuration Template
# Copy this file to .env and fill in your values.
# All partner-track vars are optional — SENTINEL core works without them.
# ─────────────────────────────────────────────────────────────────────────────

# ── Track 1: MongoDB (REQUIRED) ───────────────────────────────────────────────
# Atlas connection string: Atlas → Connect → Drivers
MONGODB_CONNECTION_STRING=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=sentinel_demo

# ── Google Cloud / Gemini (REQUIRED) ─────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.0-flash-exp
# Optional AI Studio key (if not using Vertex AI)
# GOOGLE_API_KEY=your-api-key

# ── Track 2: Arize Phoenix (observability + self-introspection MCP) ──────────
# Sign up free at https://app.phoenix.arize.com
ARIZE_PHOENIX_API_KEY=your-phoenix-api-key
ARIZE_PHOENIX_ENDPOINT=https://app.phoenix.arize.com/v1/traces
# Phoenix MCP is configured in agent/.adk/config.json (see docs/arize_setup.md)

# ── Track 3: Dynatrace (OTel traces — token spend, tool latency) ─────────────
# Sign up free at https://www.dynatrace.com/trial/
# DT_ENDPOINT format: https://<env-id>.live.dynatrace.com/api/v2/otlp
DYNATRACE_ENDPOINT=https://<env-id>.live.dynatrace.com/api/v2/otlp
DYNATRACE_TOKEN=dt0c01.<your-token>

# ── Track 4: Fivetran (pipeline healer — downstream resync) ──────────────────
# Sign up 14-day free trial at https://fivetran.com/signup
# API key: Fivetran UI → Settings → API Config
FIVETRAN_API_KEY=your-fivetran-api-key
FIVETRAN_API_SECRET=your-fivetran-api-secret

# ── Track 5: GitLab (rollback agent — auto Merge Request on ESCALATE) ────────
# Start 30-day Ultimate trial at https://about.gitlab.com/free-trial/
# Token scopes needed: api, write_repository
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
GITLAB_PROJECT_ID=your-project-id-or-encoded-path
GITLAB_API_URL=https://gitlab.com/api/v4

# ── Track 6: Elastic (incident memory layer + ES|QL history search) ──────────
# Sign up free Serverless trial at https://cloud.elastic.co
# Endpoint: Elastic Cloud console → Manage → Copy endpoint
ELASTIC_ENDPOINT=https://<deployment>.es.<region>.aws.elastic-cloud.com
ELASTIC_API_KEY=your-elastic-api-key

# ── Optional: SENTINEL audit settings ────────────────────────────────────────
SENTINEL_AUDIT_LOG=./sentinel_audit.jsonl
SENTINEL_HMAC_SIGNING_KEY=change-me-to-a-real-secret
AUTO_APPROVE_SCHEMA_CHANGES=false
